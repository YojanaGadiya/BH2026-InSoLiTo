# Copy to .env and adjust:  cp .env.example .env

MTU=1442
# Your user and group (id -u / id -g), so files created by the containers belong to you
HOST_UID=1000
HOST_GID=1000

# Optional. Defaults (in docker-compose.yml) shown here
# NEO4J_BOLT_PORT=7687
# NEO4J_HTTP_PORT=7474
# INSOLITO_PORT=8080
# Use your local Neo4j instead of the public InSoLiTo one
# INSOLITO_CONFIG=./deploy/neo4j-local.json
# JSON files that match your local Neo4j (written when you import it), so topic
# names show instead of "Cluster N"
# INSOLITO_JSON_DIR=./DB/raw_data/json_sample
